# pb-server configuration (server/src/config.ts reads only these env vars; no secret is ever in the repo).
# Local dev: every value has a safe default, `npm run server` works without this file.
# Production: copy tools/ops/pocketbarrel.env.example to /etc/pocketbarrel.env (see docs/OPS.md).

# The server refuses to start when PB_TRUST_PROXY=1 and PB_IP_KEY is missing/short, or PB_HOST is not loopback without PB_ALLOW_PUBLIC=1.
# Bind address and port (nginx proxies https://server.pocketbarrel.com/api/ to here; keep 127.0.0.1).
PB_HOST=127.0.0.1
PB_PORT=8080
# SQLite file (the folder is created). ':memory:' only for tests.
PB_DB=data/pb.sqlite
# Comma-separated browser origins allowed by CORS (exact match).
PB_ORIGINS=http://localhost:5173
# Trust X-Forwarded-For (1 only behind nginx on the same box).
PB_TRUST_PROXY=0
# Key for hashing client IPs (IPs are never stored raw). REQUIRED in production: openssl rand -hex 32
PB_IP_KEY=
# bcrypt cost (4..14, default 10, about 60 ms per hash).
PB_BCRYPT_COST=10
# Largest accepted save upload in bytes (default 1 MB).
PB_SAVE_MAX_BYTES=1000000
# Session lifetime in days (sliding).
PB_SESSION_DAYS=30
# Replaced cloud saves kept per account.
PB_BACKUPS_KEPT=10
