{
  "name": "pixel-hotel",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces && tsc -p tools/tsconfig.json",
    "simulate": "tsx tools/simulate-economy.ts",
    "simulate:dungeon": "tsx tools/simulate-dungeon.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
