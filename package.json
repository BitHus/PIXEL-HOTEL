{
  "name": "pixel-hotel",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces && tsc -p tools/tsconfig.json",
    "simulate": "tsx tools/simulate-economy.ts",
    "e2e": "playwright test",
    "lint": "biome lint",
    "simulate:dungeon": "tsx tools/simulate-dungeon.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/stats.js": "^0.17.4",
    "fast-check": "^4.10.2",
    "free-tex-packer-core": "^0.3.9",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "stats.js": "^0.17.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
