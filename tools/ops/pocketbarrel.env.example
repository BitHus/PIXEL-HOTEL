# Copy to /etc/pocketbarrel.env on the VPS (chmod 600, chown root). Make PB_IP_KEY with: openssl rand -hex 32
PB_HOST=127.0.0.1
PB_PORT=8080
PB_DB=/var/lib/pocketbarrel/pb.sqlite
PB_ORIGINS=https://pocketbarrel.com
PB_TRUST_PROXY=1
PB_IP_KEY=CHANGE_ME
PB_BCRYPT_COST=10
# Backups (tools/ops/backup-db.sh). Off-box target stays empty until the owner picks one, e.g. user@host:/backups/pb/
PB_BACKUP_DIR=/var/backups/pocketbarrel
PB_BACKUP_KEEP=14
PB_BACKUP_REMOTE=
